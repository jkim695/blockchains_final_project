% USENIX papers style file -- version 3 (2019)
% Based on the standard USENIX conference template

% Font setup - use Times Roman
\usepackage{mathptmx}  % Times for text and math
\usepackage[scaled=.92]{helvet}  % Helvetica for sans-serif
\usepackage{courier}  % Courier for mono

\usepackage[T1]{fontenc}
\usepackage{textcomp}

% Better typography
\usepackage{microtype}

% Balance columns on last page
\usepackage{flushend}

% URL formatting
\usepackage{url}

% Hyperlinks
\usepackage[breaklinks=true,hidelinks]{hyperref}

% Page layout
\setlength{\textheight}{9.0in}
\setlength{\textwidth}{7.0in}
\setlength{\columnsep}{0.33in}
\setlength{\topmargin}{0.0in}
\setlength{\headheight}{0.0in}
\setlength{\headsep}{0.0in}
\setlength{\oddsidemargin}{-0.25in}
\setlength{\evensidemargin}{-0.25in}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}

% No page numbers for submission
% \pagestyle{empty}
\pagestyle{plain}

% Title formatting
\def\maketitle{\par
 \begingroup
   \def\thefootnote{\fnsymbol{footnote}}
   \def\@makefnmark{\hbox
       to 0pt{$^{\@thefnmark}$\hss}}
     \twocolumn[\@maketitle]
\@thanks
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax
 \let\@maketitle\relax
 \gdef\@thanks{}\gdef\@author{}\gdef\@title{}\let\thanks\relax}

\def\@maketitle{\newpage
 \null
 \begin{center} {\LARGE \bf \@title} \end{center}
 \def\And{\end{tabular}\hfil\linebreak[0]\hfil
          \begin{tabular}[t]{c}\bf}
 \def\AND{\end{tabular}\hfil\linebreak[4]\hfil
          \begin{tabular}[t]{c}\bf}
 \begin{center}\large\bf\lineskip .75em
 \begin{tabular}[t]{c}\bf\@author
 \end{tabular}\par
 \end{center}
 \par
 \vskip 0.7em}

% Abstract formatting
\renewenvironment{abstract}%
{\centerline{\large\bf Abstract}%
 \begin{list}{}%
    {\setlength{\rightmargin}{0.6cm}%
     \setlength{\leftmargin}{0.6cm}}%
    \item[]\ignorespaces}%
{\unskip\end{list}}

% Section formatting
\renewcommand{\section}{\@startsection {section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}

\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}

% Suppress date
\date{}
